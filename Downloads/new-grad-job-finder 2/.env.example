# SQLite for local/personal use. This file path is relative to prisma/.
DATABASE_URL="file:./dev.db"

# Set to "true" to use the built-in mock job provider instead of live
# ATS adapters (Greenhouse/Lever/Ashby). Useful for UI development
# without hitting any external network.
USE_MOCK_DATA="false"

# Comma-separated list of companies to search by default when the user
# hasn't entered any priority companies yet. Personal-use default below.
DEFAULT_PRIORITY_COMPANIES="JPMorgan Chase,Salesforce,Citibank"

# Optional: how long (minutes) search results are cached before a plain
# "Search" re-hits live sources. "Refresh" always bypasses this cache.
SEARCH_CACHE_MINUTES="30"

# Adzuna is the broad job-aggregator source (covers thousands of
# companies automatically, no per-company config needed). Free tier:
# register at https://developer.adzuna.com/ to get these two values.
# The Muse adapter needs no API key.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
